# Copy to .env and fill in. All variables are optional except where noted.

# ── El Analista (news sentiment) ─────────────────────────────────────────────
# Free paper-trading keys from https://alpaca.markets — only needed with --analista
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# ── El Cazador (SEC EDGAR Form 4) ────────────────────────────────────────────
# Required by the SEC fair-access policy when using --cazador: "Name email@domain.com"
SEC_USER_AGENT="Your Name you@example.com"

# ── Dashboard / FastAPI ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
